# Copiar este archivo a ".env" y completar con los datos reales.
# Este .env NUNCA debe subirse a git (contiene la clave del certificado).

# Puerto donde escucha este microservicio
PORT=4000

# Token simple que Django debe mandar en el header Authorization: Bearer <token>
# (poné cualquier cadena larga y aleatoria; debe coincidir con SIFEN_SERVICE_TOKEN en settings.py de Django)
SERVICE_TOKEN=

# Ambiente de la SET: "test" (homologación) o "prod" (producción)
SIFEN_AMBIENTE=test

# MOCK=true: genera el XML real pero NO firma ni envía nada a la SET, y
# devuelve una aprobación simulada. No requiere CERT_PATH/CERT_PASSWORD/CSC
# ni RUC real — sirve para probar todo el circuito Django <-> sifen-service
# de punta a punta sin tener certificado ni estar homologado todavía.
# Poner en false cuando tengas certificado real y quieras hablar con la SET.
MOCK=true

# Certificado de firma digital (.p12) — la ruta es local a ESTE servicio.
# Solo hace falta completar esto cuando MOCK=false.
CERT_PATH=C:\ruta\a\tu\certificado.p12
CERT_PASSWORD=

# Código de Seguridad del Contribuyente (te lo da la SET al habilitarte)
CSC=
CSC_ID=1
